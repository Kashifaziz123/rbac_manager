<?xml version="1.0" encoding="UTF-8"?>
<templates id="template">
    <t t-name="rbac.UserRoles">
        <div class="container role_template">
            <div class="header">
                <p>
                    <a t-att-href=" this.is_wizard ? void(0) : '/odoo/user_roles' ">Role Template</a>
                </p>
                <h1>Define Role Template:
                    <t t-esc="this.user[0]?.name"/>
                </h1>
                <p>Configure permissions and access rights for this role template</p>
            </div>

            <div class="controls">
                <div class="search-filter-row">
                    <div class="search-box">
                        <span class="search-icon">🔍</span>
                        <input type="text" placeholder="Search permissions by name, code, or description..."
                               t-ref="searchInput" t-on-keyup="apply_search"/>
                    </div>

                    <div class="filter-dropdown">
                        <div class="filter-btn">
                            All Categories
                        </div>
                    </div>

                    <div class="risk-filter">
                        <div t-att-class="'risk-badge low' + (this.is_risk_active('low') ? ' active' : '')"
                             t-on-click="() => this.toggle_risk_level('low')">Low Risk
                        </div>
                        <div t-att-class="'risk-badge medium' + (this.is_risk_active('medium') ? ' active' : '')"
                             t-on-click="() => this.toggle_risk_level('medium')">Medium Risk
                        </div>
                        <div t-att-class="'risk-badge high' + (this.is_risk_active('high') ? ' active' : '')"
                             t-on-click="() => this.toggle_risk_level('high')">High Risk
                        </div>
                    </div>
                </div>
            </div>

            <div class="permissions-grid">
                <div class="grid-header">
                    <div>Permission</div>
                    <div>Risk Level</div>
                    <div>Enabled</div>
                </div>

                <div class="permissions-grids">
                    <t t-foreach="this.categories" t-as="category" t-key="category">
                        <div class="category-section">
                            <div class="category-header" t-on-click="(ev) => this.toggle_category_section(ev.target)">
                                <div class="category-info">
                                    <div class="category-icon academics">
                                        <t t-esc="this.getInitials(category)"/>
                                    </div>
                                    <div class="category-title">
                                        <t t-esc="category"/>
                                    </div>
                                </div>
                                <div class="category-stats">
                                    <span>
                                        <t t-esc="Object.keys(this.categories[category]).length"/>
                                        permissions
                                    </span>
                                    <span>
                                        <span class="enabled_count"/>
                                        enabled
                                    </span>
                                </div>
                                <div class="category-actions">
                                    <button class="btn btn-secondary btn-small"
                                            t-on-click="(ev) => this.toggle_category_all_checked_enabled(1, ev.target)">
                                        ✅ Enable All
                                    </button>
                                    <button class="btn btn-danger btn-small"
                                            t-on-click="(ev) => this.toggle_category_all_checked_enabled(0, ev.target)">
                                        ❌ Disable All
                                    </button>
                                    <span class="expand-icon">▼</span>
                                </div>
                            </div>
                            <t t-foreach="this.categories[category]" t-as="field" t-key="field">
                                <t t-if="this.categories[category][field]['group']">
                                    <div class="permission-item">
                                        <div class="permission-info">
                                            <h4>
                                                <t t-esc="this.categories[category][field]['group']['name']"/>
                                            </h4>
                                        </div>
                                        <div t-att-class="'risk-badge ' + this.categories[category][field]['group']['risk_level']">
                                            <t t-esc="this.categories[category][field]['group']['risk_level']"/>
                                        </div>
                                        <div>
                                            <label class="toggle-switch">
                                                <input type="checkbox"
                                                       t-att-name="field"
                                                       t-att-checked="this.getFieldValue(field, this.categories[category][field]) ? 'checked' : undefined"
                                                       t-on-change="(ev) => this.update_values(ev.target)"
                                                />
                                                <span class="slider"/>
                                            </label>
                                        </div>
                                    </div>
                                </t>
                                <t t-else="">
                                    <t t-foreach="this.categories[category][field]['groups']" t-as="group"
                                       t-key="group.id">
                                        <div class="permission-item">
                                            <div class="permission-info">
                                                <h4>
                                                    <t t-esc="group.name"/>
                                                </h4>
                                            </div>
                                            <div t-att-class="'risk-badge ' + group.risk_level">
                                                <t t-esc="group.risk_level"/>
                                            </div>
                                            <div>
                                                <label class="toggle-switch">
                                                    <input type="radio"
                                                           t-att-name="field"
                                                           t-att-value="group.id"
                                                           t-att-checked="group.id === this.getFieldValue(field, this.categories[category][field]) ? 'checked' : undefined"
                                                           t-on-change="(ev) => this.update_values(ev.target)"
                                                    />
                                                    <span class="slider"/>
                                                </label>
                                            </div>
                                        </div>
                                    </t>
                                </t>
                            </t>
                        </div>
                    </t>
                </div>
            </div>


            <div class="actions">
                <div class="pagination">
                    <span>Showing <t t-esc="this.paginationStart"/>–<t t-esc="this.paginationEnd"/> of <t t-esc="this.pageInfo.total"/> permissions</span>
                    <button class="page-btn"
                            t-att-disabled="this.filterState.currentPage &lt;= 1 ? 'disabled' : undefined"
                            t-on-click="prevPage">← Previous</button>
                    <t t-foreach="this.getPageNumbers()" t-as="page" t-key="page">
                        <button t-att-class="'page-btn' + (page === this.filterState.currentPage ? ' active' : '')"
                                t-on-click="() => this.goToPage(page)">
                            <t t-esc="page"/>
                        </button>
                    </t>
                    <button class="page-btn"
                            t-att-disabled="this.filterState.currentPage >= this.pageInfo.totalPages ? 'disabled' : undefined"
                            t-on-click="nextPage">Next →</button>
                </div>

                <div style="display: flex; gap: 12px;">
                    <button class="btn btn-secondary" t-on-click="discardRecord">Discard Changes</button>
                    <button class="btn btn-primary" t-on-click="writeRecord">Save Role Template</button>
                </div>
            </div>
        </div>
    </t>
</templates>
