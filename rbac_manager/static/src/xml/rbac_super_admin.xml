<?xml version="1.0" encoding="UTF-8"?>
<templates id="template">
    <t t-name="rbac.SuperAdmin">
        <div class="container rbac_super_admin">
            <div class="header">
                <div class="user-info">
                    <div class="user-avatar">
                        <t t-esc="this.getInitials(this.user[0]?.name)"/>
                    </div>
                    <div class="user-details">
                        <h1>Manage Permissions:
                            <t t-esc="this.user[0]?.name"/>
                        </h1>
                        <p>
                            <t t-esc="this.user[0]?.email"/>
                            • Employee ID:
                            <t t-esc="this.data?.employee?.barcode || 'N/A'"/>
                        </p>
                    </div>
                    <div class="access-level">
                        👑 Super Admin Access
                    </div>
                </div>
                <div class="header-actions">
                    <a href="/odoo/super_admin" class="btn btn-secondary">← Back to Details</a>
                    <button class="btn btn-primary" t-on-click="writeRecord">💾 Save Changes</button>
                </div>
            </div>

            <!-- Super Admin Toolbar -->
            <div class="admin-toolbar">
                <div class="toolbar-header">
                    <div class="toolbar-title">
                        ⚡ Super Admin Controls
                    </div>
                    <div class="toolbar-actions">
                        <button class="btn btn-secondary btn-small">📋 View Change Log</button>
                    </div>
                </div>

                <div class="quick-actions">
                    <div class="quick-action" t-on-click="(ev) => this.toggle_all_checked_enabled(1)">
                        ✅ Grant All Permissions
                    </div>
                    <div class="quick-action" t-on-click="(ev) => this.toggle_all_checked_enabled(0)">
                        ❌ Revoke All Permissions
                    </div>
                    <div class="quick-action" t-on-click="clone_from_another_user">
                        👤 Clone from Another User
                    </div>
                    <div class="quick-action" t-on-click="multi_apply_roles">
                        📦 Bulk Role Assignment
                    </div>
                    <div class="quick-action" t-on-click="export_permissions">
                        📤 Export Permissions
                    </div>
                </div>
            </div>

            <div class="content-grid" t-att-data-group_sources="this.data?.json_group_sources">
                <!-- Current Roles Section -->
                <div class="section">
                    <h2>👥 Assigned Roles</h2>
                    <t t-foreach="this.data?.assigned_roles" t-as="role" t-key="role.name + '_assigned_roles' ">
                        <div class="role-item">
                            <div class="role-info">
                                <div class="role-icon teacher">
                                    <t t-esc="role?.name[0]"/>
                                </div>
                                <div class="role-details">
                                    <h4>
                                        <t t-esc="role?.name"/>
                                    </h4>
                                    <p>?? permissions • Assigned ?? months ago</p>
                                </div>
                            </div>
                            <div class="role-actions">
                                <button class="btn btn-secondary btn-small"
                                        t-on-click="(ev) => this.view_user_role(role.id)">👁️ View
                                </button>
                                <button class="btn btn-danger btn-small"
                                        t-on-click="(ev) => this.remove_role(role)">✗ Remove
                                </button>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- Available Roles Section -->
                <div class="section">
                    <h2>➕ Available Roles</h2>
                    <div class="available-roles">
                        <t t-foreach="this.data?.available_roles" t-as="role" t-key="role.name">
                            <div class="role-item available">
                                <div class="role-info">
                                    <div class="role-icon librarian">
                                        <t t-esc="role?.name[0]"/>
                                    </div>
                                    <div class="role-details">
                                        <h4>
                                            <t t-esc="role.name"/>
                                        </h4>
                                        <p>
                                            <t t-esc="role.permissions_count"/>
                                            permissions •
                                            <t t-esc="role.description"/>
                                        </p>
                                    </div>
                                </div>
                                <div class="role-actions">
                                    <button class="btn btn-primary btn-small"
                                            t-on-click="(ev) => this.assign_role(role)">+ Assign
                                    </button>
                                    <button class="btn btn-secondary btn-small"
                                            t-on-click="(ev) => this.view_user_role(role.id)">👁️ Preview
                                    </button>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <!-- Direct Permission Management -->
            <div class="permissions-section">
                <div class="permissions-header">
                    <h2>🔐 Direct Permission Management</h2>
                    <div class="permissions-filters">
                        <div class="filter-tab active all" t-on-click="(ev) => this.toggle_filters(ev.target)">
                            All (<t t-esc="this.data?.all_groups_count"/>)
                        </div>
                        <div class="filter-tab granted" t-on-click="(ev) => this.toggle_filters(ev.target)">
                            Granted (<t t-esc="this.data?.is_granted"/>)
                        </div>
                        <div class="filter-tab denied" t-on-click="(ev) => this.toggle_filters(ev.target)">
                            Denied (<t t-esc="this.data?.is_denied"/>)
                        </div>
                        <div class="filter-tab high_risk" t-on-click="(ev) => this.toggle_filters(ev.target)">
                            High Risk (<t t-esc="this.data?.is_high_risk"/>)
                        </div>
                        <div class="filter-tab overrides" t-on-click="(ev) => this.toggle_filters(ev.target)">
                            Overrides (<t t-esc="this.data?.is_overrides"/>)
                        </div>
                    </div>
                </div>

                <div class="permissions-grid">
                    <t t-set="categories" t-value="this.data?.all_categories || {}"/>
                    <t t-foreach="categories" t-as="category" t-key="category">
                        <div class="permission-category">
                            <div class="category-header" t-on-click="(ev) => this.toggle_category_section(ev.target)">
                                <div class="category-info">
                                    <div class="category-icon academics">
                                        <t t-esc="this.getInitials(category)"/>
                                    </div>
                                    <div class="category-title">
                                        <t t-esc="category"/>
                                    </div>
                                </div>
                                <div class="category-stats">
                                    <span>
                                        <t t-esc="Object.keys(categories[category]).length"/>
                                        permissions
                                    </span>
                                    <span>
                                        <span class="enabled_count"/>
                                        enabled
                                    </span>
                                </div>
                                <div class="category-actions">
                                    <!--                                    <button class="btn btn-secondary btn-small"-->
                                    <!--                                            t-on-click="(ev) => this.toggle_category_all_checked_enabled(1, ev.target)">-->
                                    <!--                                        ✅ Enable All-->
                                    <!--                                    </button>-->
                                    <!--                                    <button class="btn btn-danger btn-small"-->
                                    <!--                                            t-on-click="(ev) => this.toggle_category_all_checked_enabled(0, ev.target)">-->
                                    <!--                                        ❌ Disable All-->
                                    <!--                                    </button>-->
                                    <span class="expand-icon">▼</span>
                                </div>
                            </div>
                            <div class="category-content">
                                <t t-foreach="categories[category]" t-as="field" t-key="field">
                                    <t t-if="categories[category][field]['group']">
                                        <t t-set="is_checkbox" t-value="1"/>
                                        <t t-set="permission_type" t-value="categories[category][field]['group']"/>
                                        <t t-call="rbac.SuperAdmin_Permissions"/>
                                    </t>
                                    <t t-else="">
                                        <t t-foreach="categories[category][field]['groups']" t-as="group"
                                           t-key="group.id">
                                            <t t-set="is_checkbox" t-value="0"/>
                                            <t t-set="permission_type" t-value="group"/>
                                            <t t-call="rbac.SuperAdmin_Permissions"/>
                                        </t>
                                    </t>
                                </t>
                            </div>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Recent Activity Audit Log -->
            <div class="audit-log">
                <h2>📋 Recent Permission Changes</h2>
            </div>

            <!-- Floating Super Admin Panel -->
            <div class="floating-admin-panel" style="display:none;">
                <div class="admin-panel-header">🔥 SUPER ADMIN</div>
                <div class="admin-quick-actions">
                    <button class="admin-action-btn grant-all" t-on-click="(ev) => this.toggle_all_checked_enabled(1)">
                        ⚡ Emergency Grant All
                    </button>
                    <button class="admin-action-btn revoke-all" t-on-click="(ev) => this.toggle_all_checked_enabled(0)">
                        🚨 Emergency Revoke All
                    </button>
                    <button class="admin-action-btn audit" onclick="fullAuditReport()">
                        📊 Full Audit Report
                    </button>
                </div>
            </div>
        </div>
    </t>
    <t t-name="rbac.SuperAdmin_Permissions">
        <div class="permission-item">
            <div class="permission-details">
                <h5>
                    <t t-esc="permission_type.name"/>
                </h5>
                <div class="permission-code"></div>
                <!--                                                <div class="override-indicator">EXCLUSION OVERRIDE</div>-->
            </div>
            <div>
                <div t-att-class="'risk-badge ' +  permission_type.risk_level ">
                    <t t-esc="permission_type.risk_level"/>
                </div>
                <div>
                    <t t-if="this.data?.group_sources[permission_type.id]">
                        <t t-foreach="this.data.group_sources[permission_type.id]" t-as="tag"
                           t-key="tag + '_permission_type_sa_' + permission_type.id ">
                            <t t-if="tag.startsWith('role')">
                                <div t-att-class=" 'risk-badge role' ">
                                    Role:
                                    <t t-esc="this.data?.roles[tag.substring(5)]"/>
                                </div>
                            </t>
                        </t>
                    </t>
                </div>

            </div>
            <t t-if="is_checkbox">
                <label class="toggle-switch">
                    <input type="checkbox"
                           t-att-name="field"
                           t-att-checked="categories[category][field]['value']"
                           t-on-change="(ev) => this.update_values(ev.target)"
                    />
                    <span class="slider"/>
                </label>
            </t>
            <t t-else="">
                <label class="toggle-switch">
                    <input type="radio"
                           t-att-name="field"
                           t-att-value="permission_type.id"
                           t-att-checked="permission_type.id === categories[category][field]['value'] ? 'checked' : undefined"
                           t-on-change="(ev) => this.update_values(ev.target)"
                    />
                    <span class="slider"/>
                </label>
            </t>
            <div class="role-actions">
                <t t-if="this.data?.group_sources[permission_type.id]">
                    <t t-set="tags" t-value="[]"/>
                    <t t-if=" !this.data.group_sources[permission_type.id].includes('initial') ">
                        <button class="btn btn-small" style="color: transparent;">✗ Base</button>
                    </t>
                    <t t-foreach="this.data.group_sources[permission_type.id]" t-as="tag"
                       t-key="tag + '_permission_type_sa_' + permission_type.id ">
                        <t t-if="tag.startsWith('initial')">
                            <t t-set="tags" t-value="tags + ['initial'] "/>
                            <button class="btn btn-warning btn-small"
                                    t-on-click="(ev) => this.remove_initial(permission_type)">✗ Base
                            </button>
                        </t>
                        <t t-elif="tag.startsWith('direct_add')">
                            <t t-set="tags" t-value="tags + ['direct_add'] "/>
                            <button class="btn btn-danger btn-small"
                                    t-on-click="(ev) => this.remove_extra(permission_type)">✗ Extra
                            </button>
                        </t>
                        <t t-elif="tag.startsWith('excluded')">
                            <t t-set="tags" t-value="tags + ['excluded'] "/>
                            <button class="btn btn-danger btn-small"
                                    t-on-click="(ev) => this.remove_exclude(permission_type)">✗ Exclude
                            </button>
                        </t>
                    </t>
                    <t t-if="!tags.includes('direct_add')">
                        <button class="btn btn-primary btn-small"
                                t-on-click="(ev) => this.assign_extra(permission_type)">+ Extra
                        </button>
                    </t>
                    <t t-if="!tags.includes('excluded')">
                        <button class="btn btn-primary btn-small"
                                t-on-click="(ev) => this.assign_exclude(permission_type)">+ Exclude
                        </button>
                    </t>
                </t>
                <t t-else="">
                    <button class="btn btn-small" style="color: transparent;">✗ Base</button>
                    <button class="btn btn-primary btn-small"
                            t-on-click="(ev) => this.assign_extra(permission_type)">+ Extra
                    </button>
                    <button class="btn btn-primary btn-small"
                            t-on-click="(ev) => this.assign_exclude(permission_type)">+ Exclude
                    </button>
                </t>
                <t t-if="!is_base">

                </t>
            </div>
        </div>
    </t>
</templates>
