<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.WebClient" t-inherit-mode="extension">
        <xpath expr="//ActionContainer" position="replace">
            <div class="rsh_child_shell">
                <t t-if="!state.fullscreen">
                    <RBACGlobalSidebar/>
                </t>
                <div class="rsh_child_content">
                    <ActionContainer/>
                </div>
            </div>
        </xpath>
    </t>

    <t t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='currentAppSections.length' and @t-call='web.NavBar.SectionsMenu']" position="replace"/>
    </t>

    <t t-inherit="web.Breadcrumbs" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_last_breadcrumb_item')]/span[1]" position="before">
            <t t-if="this.rbacRootBreadcrumb">
                <button type="button"
                        class="rsh_cp_root_breadcrumb"
                        t-on-click.prevent="() => this.openRbacRootBreadcrumb()"
                        t-esc="this.rbacRootBreadcrumb.name"/>
                <i class="fa fa-chevron-right rsh_cp_breadcrumb_sep"/>
            </t>
        </xpath>
    </t>

    <t t-name="rbac.GlobalSidebar">
        <div t-att-class="'rsh_global_nav rsh_child_nav' + (this.state.panelOpen ? '' : ' rsh_child_nav_closed')">
            <button t-if="!this.state.panelOpen"
                    type="button"
                    class="rsh_sidebar_reopen"
                    t-att-title="'Open ' + (this.activeApp ? this.activeApp.name : 'menu') + ' menu'"
                    t-on-click="togglePanel">
                <i class="fa fa-angle-right"/>
            </button>
            <aside t-att-class="'rsh_sidebar rsh_global_sidebar' + (this.state.panelOpen ? '' : ' rsh_sidebar_closed')">
                <div class="rsh_sidebar_header">
                    <div>
                        <h2 t-esc="this.activeApp ? this.activeApp.name : 'Workspace'"/>
                        <p>AlhadiTech RBAC</p>
                    </div>
                    <button class="rsh_sidebar_toggle" title="Collapse" t-on-click="togglePanel">
                        <i class="fa fa-columns"/>
                    </button>
                </div>

                <div class="rsh_sidebar_body">
                    <t t-if="this.activeApp">
                        <t t-if="this.isActiveAppRbac">
                            <t t-if="!this.activeAppChildren.length">
                                <div class="rsh_sidebar_section">
                                    <div class="rsh_sidebar_section_label">Overview</div>
                                    <button t-att-class="'rsh_sidebar_item' + (this.isActiveApp(this.activeApp) ? ' active' : '')"
                                            t-on-click="() => this.selectApp(this.activeApp)">
                                        <span>Dashboard</span>
                                    </button>
                                </div>
                            </t>

                            <t t-foreach="this.getRbacSidebarGroups()" t-as="group" t-key="group.label">
                                <div class="rsh_sidebar_section">
                                    <div class="rsh_sidebar_section_label" t-esc="group.label"/>
                                    <t t-foreach="group.items" t-as="section" t-key="section.id">
                                        <t t-call="rbac.GlobalSidebarItem">
                                            <t t-set="item" t-value="section"/>
                                        </t>
                                    </t>
                                </div>
                            </t>
                        </t>
                        <t t-else="">
                            <div class="rsh_sidebar_section">
                                <div class="rsh_sidebar_section_label" t-esc="this.activeApp.name"/>

                                <t t-if="!this.activeAppChildren.length">
                                    <button t-att-class="'rsh_sidebar_item' + (this.isActiveApp(this.activeApp) ? ' active' : '')"
                                            t-on-click="() => this.selectApp(this.activeApp)">
                                        <t t-if="this.hasMenuIconData(this.activeApp)">
                                            <img class="rsh_menu_icon_img" t-att-src="this.getMenuIconDataSrc(this.activeApp)" t-att-alt="this.activeApp.name"/>
                                        </t>
                                        <span>Dashboard</span>
                                    </button>
                                </t>

                                <t t-foreach="this.activeAppChildren" t-as="section" t-key="section.id">
                                    <t t-call="rbac.GlobalSidebarItem">
                                        <t t-set="item" t-value="section"/>
                                    </t>
                                </t>
                            </div>
                        </t>
                    </t>
                </div>
            </aside>
        </div>
    </t>

    <t t-name="rbac.GlobalSidebarItem">
        <t t-if="item">
            <t t-if="this.shouldFlattenSection(item)">
                <t t-foreach="this.getMenuChildren(item)" t-as="child" t-key="child.id">
                    <t t-call="rbac.GlobalSidebarItem">
                        <t t-set="item" t-value="child"/>
                    </t>
                </t>
            </t>
            <t t-elif="item.children and item.children.length and !item.actionID">
                <div class="rsh_sidebar_group">
                    <button t-att-class="'rsh_sidebar_group_title' + (this.isSectionExpanded(item.id) ? ' open' : '') + (this.isActiveMenu(item) ? ' active' : '')"
                            t-on-click="() => this.toggleSection(item.id)">
                        <i class="fa fa-chevron-right rsh_sidebar_chevron"/>
                        <t t-if="this.hasMenuIconData(item)">
                            <img class="rsh_menu_icon_img" t-att-src="this.getMenuIconDataSrc(item)" t-att-alt="item.name"/>
                        </t>
                        <i t-elif="this.getSidebarItemIcon(item)" t-att-class="'fa ' + this.getSidebarItemIcon(item)"/>
                        <span t-esc="this.getDisplayMenuName(item)"/>
                    </button>
                    <div t-att-class="'rsh_sidebar_group_body' + (this.isSectionExpanded(item.id) ? ' open' : '')">
                        <t t-foreach="this.getMenuChildren(item)" t-as="child" t-key="child.id">
                            <t t-call="rbac.GlobalSidebarItem">
                                <t t-set="item" t-value="child"/>
                            </t>
                        </t>
                    </div>
                </div>
            </t>
            <t t-else="">
                <button t-att-class="'rsh_sidebar_item' + (this.isActiveMenu(item) ? ' active' : '')"
                        t-on-click="() => this.selectMenu(item)">
                    <t t-if="this.hasMenuIconData(item)">
                        <img class="rsh_menu_icon_img" t-att-src="this.getMenuIconDataSrc(item)" t-att-alt="item.name"/>
                    </t>
                    <i t-elif="this.getSidebarItemIcon(item)" t-att-class="'fa ' + this.getSidebarItemIcon(item)"/>
                    <span t-esc="this.getDisplayMenuName(item)"/>
                </button>
            </t>
        </t>
    </t>

    <t t-name="rbac.GlobalTopbar">
        <div class="rsh_topbar rsh_global_topbar">
            <div class="rsh_breadcrumb">
                <t t-foreach="this.currentMenuPath" t-as="crumb" t-key="crumb.id">
                    <button type="button"
                            t-att-class="crumb_index === 0 ? 'rsh_bc_app rsh_bc_btn' : 'rsh_bc_current rsh_bc_btn'"
                            t-on-click="() => this.onBreadcrumbClick(crumb, crumb_index + 1 === this.currentMenuPath.length)"
                            t-esc="crumb.name"/>
                    <i t-if="crumb_index + 1 &lt; this.currentMenuPath.length" class="fa fa-chevron-right rsh_bc_sep"/>
                </t>
                <t t-if="!this.currentMenuPath.length">
                    <button type="button" class="rsh_bc_app rsh_bc_btn" t-esc="this.currentAppName"/>
                </t>
            </div>

            <div class="rsh_topbar_search" t-on-click.stop="">
                <i class="fa fa-search rsh_tsearch_icon"/>
                <input class="rsh_tsearch_input"
                       type="text"
                       placeholder="Search apps, menus, actions..."
                       t-att-value="state.query"
                       t-on-input="(ev) => this.onSearchInput(ev)"
                       t-on-focus="() => this.openSearch()"
                       t-on-keydown="(ev) => this.onSearchKeydown(ev)"/>
                <div t-if="state.open and this.searchResults.length" class="rsh_global_search_dropdown">
                    <button t-foreach="this.searchResults"
                            t-as="result"
                            t-key="result.type + '-' + result.item.id"
                            type="button"
                            t-att-class="'rsh_global_search_item' + (result_index === state.activeIndex ? ' active' : '')"
                            t-on-click="() => this.selectSearchResult(result)">
                        <span class="rsh_global_search_type" t-esc="result.type"/>
                        <span class="rsh_global_search_text">
                            <span class="rsh_global_search_title" t-esc="result.title"/>
                            <span class="rsh_global_search_sub" t-esc="result.sub"/>
                        </span>
                    </button>
                </div>
            </div>

            <div class="rsh_topbar_right">
                <span t-if="this.isDebugMode &amp;&amp; this.dbName" class="rsh_db_badge" t-att-title="'Database: ' + this.dbName">
                    <i class="fa fa-database"/>
                    <span t-esc="this.dbName"/>
                </span>
                <div t-if="this.allowedCompanies.length" class="rsh_company_selector" t-on-click.stop="">
                    <button type="button"
                            t-att-class="'rsh_company_button' + (this.state.companyOpen ? ' open' : '')"
                            t-att-disabled="!this.hasMultipleCompanies"
                            t-att-title="this.activeCompanyName"
                            t-on-click="() => this.toggleCompanySelector()">
                        <i class="fa fa-building-o"/>
                        <span t-esc="this.activeCompanyName"/>
                        <i t-if="this.hasMultipleCompanies" class="fa fa-angle-down rsh_company_caret"/>
                    </button>
                    <div t-if="this.state.companyOpen &amp;&amp; this.hasMultipleCompanies" class="rsh_company_dropdown">
                        <button t-foreach="this.allowedCompanies"
                                t-as="company"
                                t-key="company.id"
                                type="button"
                                t-att-class="'rsh_company_option' + (this.isActiveCompany(company) ? ' active' : '')"
                                t-on-click="() => this.switchCompany(company)">
                            <span class="rsh_company_option_name" t-esc="company.name"/>
                            <i t-if="this.isActiveCompany(company)" class="fa fa-check"/>
                        </button>
                    </div>
                </div>
                <div class="rsh_topbar_user_menu">
                    <UserMenu/>
                </div>
            </div>
        </div>
    </t>
</templates>
