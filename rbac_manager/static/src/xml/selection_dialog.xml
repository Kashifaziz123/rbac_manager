<?xml version="1.0" encoding="UTF-8"?>
<templates id="template">
    <t t-name="rbac.UserSelectionDialog">
        <Dialog size="'md'" title="props.title">
            <div class="rbac_dialog user_selection_dialog">
                <div class="info-alert">
                    <span class="alert-icon">ℹ️</span>
                    <div class="alert-text">
                        All roles and permissions from the selected user will be copied to the target user. Existing
                        permissions will be preserved.
                    </div>
                </div>

                <!-- Target User - Compact Inline -->
                <div class="compact-inline">
                    <div class="avatar">
                        <t t-esc="this.getInitials(props.target_user.name || '')"/>
                    </div>
                    <div class="text">
                        Applying permissions to
                        <span class="user-name-highlight">
                            <t t-esc="props.target_user.name || 'Unknown User'"/>
                        </span>
                    </div>
                </div>
                <div class="source-section">
                    <h3>Select user to clone permissions from</h3>

                    <!-- Search -->
                    <div class="search-box">
                        <span class="search-icon">🔍</span>
                        <input
                                type="text"
                                class="search-input"
                                id="searchInput"
                                placeholder="Search by name or email..."
                                t-on-keyup="apply_search"
                        />
                    </div>
                    <!-- User List -->
                    <div class="user-list" id="userList">
                        <t t-foreach="clone_users" t-as="user" t-key="user.id">
                            <div t-att-class="'user-item ' + (selectedUser === user.id ? 'selected' : '' )"
                                 t-att-data-id="user.id"
                                 t-on-click="(ev) => this.user_selected(ev.target)"
                                 t-att-data-categories="user.categories">
                                <div class="user-info">
                                    <div class="user-avatar"
                                         t-att-style="'background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);'">
                                        <t t-esc="this.getInitials(user.name)"/>
                                    </div>
                                    <div class="user-details">
                                        <div class="user-name">
                                            <t t-esc="user.name"/>
                                        </div>
                                        <div class="user-role">
                                            <t t-esc="user.email or ''"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="radio-wrapper">
                                    <div class="radio-circle">
                                        <div class="radio-dot"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                    <!-- No Results Message -->
                    <div class="no-results" id="noResults" style="display: none;">
                        <div style="font-size: 32px; margin-bottom: 8px;">🔍</div>
                        No users found matching your search
                    </div>
                </div>
                <!--                <div class="user-list" id="userList">-->
                <!--                    <t t-foreach="clone_users" t-as="user" t-key="user.id + '_user_selection_dialog' ">-->
                <!--                        <div t-att-class="'user-item' + (selectedUser === user.id ? 'active' : '' )"-->
                <!--                             t-att-data-id="user.id"-->
                <!--                             t-on-click="(ev) => this.user_selected(ev.target)"-->
                <!--                             t-att-data-categories="user.categories">-->
                <!--                            <div class="user-info">-->
                <!--                                <div class="user-avatar">-->
                <!--                                    <t t-esc="this.getInitials(user.name)"/>-->
                <!--                                </div>-->
                <!--                                <div class="user-details">-->
                <!--                                    <div class="user-name">-->
                <!--                                        <t t-esc="user.name"/>-->
                <!--                                    </div>-->
                <!--                                </div>-->
                <!--                            </div>-->
                <!--                            <div class="radio-btn"></div>-->
                <!--                        </div>-->
                <!--                    </t>-->
                <!--                </div>-->
                <div t-att-class="'preview-section' + (selectedUser !== 0 ? ' active' : '')" id="previewSection">
                    <div class="preview-header">
                        <h4 class="preview-title">Permissions Preview</h4>
                    </div>
                    <div class="preview-tags" id="rolesPreview"></div>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn" t-att-class="props.confirmClass" t-on-click="_confirm" t-esc="props.confirmLabel"
                        t-att-disabled="this.selectedUser !== 0 ? '' : 'disabled' "/>
                <button t-if="props.cancel" class="btn btn-secondary" t-on-click="_cancel" t-esc="props.cancelLabel"/>
            </t>
        </Dialog>
    </t>

    <t t-name="rbac.RoleSelectionDialog">
        <Dialog size="'md'" title="props.title">
            <div class="rbac_dialog user_selection_dialog">
                <div class="info-alert">
                    <span class="alert-icon">ℹ️</span>
                    <div class="alert-text">
                        All roles and permissions from the selected user will be copied to the target user. Existing
                        permissions will be preserved.
                    </div>
                </div>

                <!-- Target User - Compact Inline -->
                <div class="compact-inline">
                    <div class="avatar">
                        <t t-esc="this.getInitials(props.target_user.name || '')"/>
                    </div>
                    <div class="text">
                        Applying role to
                        <span class="user-name-highlight">
                            <t t-esc="props.target_user.name || 'Unknown User'"/>
                        </span>
                    </div>
                </div>
                <div class="user-list" id="userList">
                    <t t-foreach="props.roles" t-as="role" t-key="role.id + '_role_selection_dialog'">
                        <div t-att-class="'user-item ' + (this.selectedRoles.includes(role.id) ? 'selected' : '')"
                             t-att-data-id="role.id"
                             t-on-click="(ev) => this.role_selected(ev.target)">
                            <div class="user-info">
                                <div class="user-avatar"
                                     t-att-style="'background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);'">
                                    <t t-esc="role.name[0]"/>
                                </div>
                                <div class="user-details">
                                    <div class="user-name">
                                        <t t-esc="role.name"/>
                                    </div>
                                </div>
                            </div>
                            <div class="radio-wrapper">
                                <div class="radio-circle">
                                    <div class="radio-dot"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
                <div t-att-class=" 'preview-section active' " id="previewSection">
                    <div class="preview-title">
                        <span>⚡</span>
                        <span>Selected Roles</span>
                    </div>
                    <div class="roles-preview" id="rolesPreview">
                        <t t-foreach="selectedRoles" t-as="role" t-key="role_index + '_selected_roles' ">
                            <span class="preview-tag">
                                <t t-esc="roles[role]"/>
                            </span>
                        </t>
                    </div>
                </div>
            </div>
            <!--            <div class="rbac_super_admin rbac_dialog">-->
            <!--                <t t-foreach="props.roles" t-as="role" t-key="role.id + '_selection_dialog' ">-->
            <!--                    <div class="permission-item">-->
            <!--                        <div class="permission-details">-->
            <!--                            <h5>-->
            <!--                                <t t-esc="role.name"/>-->
            <!--                            </h5>-->
            <!--                        </div>-->
            <!--                        <label class="toggle-switch">-->
            <!--                            <input type="checkbox" t-att-name="'user'" t-att-value="role.id"/>-->
            <!--                            <span class="slider"/>-->
            <!--                        </label>-->
            <!--                    </div>-->
            <!--                </t>-->
            <!--            </div>-->
            <t t-set-slot="footer">
                <button class="btn" t-att-class="props.confirmClass" t-on-click="_confirm" t-esc="props.confirmLabel"
                        t-att-disabled="this.selectedRoles.length !== 0 ? '' : 'disabled' "/>
                <button t-if="props.cancel" class="btn btn-secondary" t-on-click="_cancel" t-esc="props.cancelLabel"/>
            </t>
        </Dialog>
    </t>
</templates>