<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rbac.Audit">
        <div class="ra_wrap">
            <div class="ra_header">
                <div>
                    <h1>Audit Log</h1>
                    <p>Complete history of all permission changes.</p>
                </div>
                <button class="ra_btn" t-on-click="exportCSV">Export CSV</button>
            </div>

            <div class="ra_filters">
                <div class="ra_search">
                    <i class="fa fa-search"/>
                    <input type="text" placeholder="Search events..." t-on-input="(ev) => this.onSearch(ev)"/>
                </div>
                <select class="ra_select" t-on-change="(ev) => this.onCategory(ev)">
                    <option value="">All Categories</option>
                    <t t-foreach="this.categories" t-as="category" t-key="category">
                        <option t-att-value="category" t-esc="category.charAt(0).toUpperCase() + category.slice(1)"/>
                    </t>
                </select>
                <select class="ra_select" t-on-change="(ev) => this.onAdmin(ev)">
                    <option value="">All Performed By</option>
                    <t t-foreach="state.admins" t-as="admin" t-key="admin.id">
                        <option t-att-value="admin.id" t-esc="admin.name"/>
                    </t>
                </select>
                <select class="ra_select" t-on-change="(ev) => this.onRange(ev)">
                    <option value="90">Last 90 days</option>
                    <option value="30">Last 30 days</option>
                    <option value="7">Last 7 days</option>
                    <option value="">All time</option>
                </select>
            </div>

            <div class="ra_table">
                <div class="ra_thead">
                    <div>Date</div>
                    <div>Event</div>
                    <div>Performed By</div>
                    <div>Target</div>
                    <div>Category</div>
                </div>

                <t t-if="state.loading">
                    <div class="ra_empty">Loading audit log...</div>
                </t>
                <t t-elif="!this.filteredLogs.length">
                    <div class="ra_empty">No audit events found.</div>
                </t>
                <t t-else="">
                    <button class="ra_row" type="button" t-foreach="this.filteredLogs" t-as="log" t-key="log.id" t-on-click="() => this.openDetails(log)">
                        <div class="ra_date">
                            <strong t-esc="this.displayDate(log)"/>
                            <span t-esc="this.displayTime(log)"/>
                        </div>
                        <div class="ra_event">
                            <span t-att-class="'ra_dot ' + this.eventDotClass(log)"/>
                            <span>
                                <strong t-esc="this.eventTitle(log)"/>
                                <small t-esc="this.eventDescription(log)"/>
                            </span>
                        </div>
                        <div class="ra_name" t-esc="log.create_uid[0]"/>
                        <div class="ra_name" t-esc="log.user_uid[0]"/>
                        <div>
                            <span t-att-class="'ra_cat ' + this.categoryClass(log)" t-esc="this.categoryLabel(log)"/>
                        </div>
                    </button>
                </t>
            </div>

            <div t-att-class="'ra_modal_overlay' + (state.activeLog ? ' open' : '')" t-on-click.self="closeDetails">
                <div class="ra_modal" t-if="state.activeLog">
                    <div class="ra_modal_head">
                        <div>
                            <h2>Audit Log Details</h2>
                            <p t-esc="this.eventTitle(state.activeLog)"/>
                        </div>
                        <button t-on-click="closeDetails"><i class="fa fa-times"/></button>
                    </div>
                    <div class="ra_modal_body">
                        <div class="ra_detail_grid">
                            <div><label>Timestamp</label><strong><t t-esc="this.displayDate(state.activeLog)"/> <t t-esc="this.displayTime(state.activeLog)"/></strong></div>
                            <div><label>Category</label><strong t-esc="this.categoryLabel(state.activeLog)"/></div>
                            <div><label>Performed By</label><strong t-esc="state.activeLog.create_uid[0]"/></div>
                            <div><label>Target User</label><strong t-esc="state.activeLog.user_uid[0]"/></div>
                            <div><label>IP Address</label><strong t-esc="state.activeLog.ip_address || 'N/A'"/></div>
                            <div><label>Action</label><strong t-esc="state.activeLog.action"/></div>
                        </div>

                        <div class="ra_detail_section">
                            <h3>What Changed</h3>
                            <t t-if="!this.changeSummary(state.activeLog).length">
                                <div class="ra_empty_inner">No detailed change summary recorded.</div>
                            </t>
                            <t t-foreach="this.changeSummary(state.activeLog)" t-as="line" t-key="line_index">
                                <div class="ra_change simple">
                                    <i class="fa fa-check-circle-o"/>
                                    <span t-esc="line.message"/>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div class="ra_modal_footer">
                        <span>Logged and immutable</span>
                        <button class="ra_btn" t-on-click="closeDetails">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
