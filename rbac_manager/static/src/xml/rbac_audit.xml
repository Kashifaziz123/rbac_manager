<?xml version="1.0" encoding="UTF-8"?>
<templates id="template">
    <t t-name="rbac.Audit">
        <div class="container rbac_audit">
            <!-- Tab 2: Full Audit Log -->
            <div id="audit-log" class="tab-content">
                <!--                <div class="stats-grid">-->
                <!--                    <div class="stat-card">-->
                <!--                        <div class="stat-value">??</div>-->
                <!--                        <div class="stat-label">Total Changes This Month</div>-->
                <!--                    </div>-->
                <!--                    <div class="stat-card">-->
                <!--                        <div class="stat-value">??</div>-->
                <!--                        <div class="stat-label">Users Modified</div>-->
                <!--                    </div>-->
                <!--                    <div class="stat-card">-->
                <!--                        <div class="stat-value">??</div>-->
                <!--                        <div class="stat-label">Active Administrators</div>-->
                <!--                    </div>-->
                <!--                    <div class="stat-card">-->
                <!--                        <div class="stat-value">??</div>-->
                <!--                        <div class="stat-label">Failed Attempts</div>-->
                <!--                    </div>-->
                <!--                </div>-->

                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Permission Audit Log</h3>
                        <div class="action-buttons">
                            <button class="btn btn-secondary" t-on-click="() => this.onExport('csv')">📥 Export CSV
                            </button>
                            <button class="btn btn-secondary" t-on-click="() => this.onExport('pdf')">📄 Export PDF
                            </button>
                        </div>
                    </div>

                    <div class="filters-bar">
                        <div class="filter-group">
                            <label class="filter-label">Search</label>
                            <input type="text"
                                   class="filter-input"
                                   placeholder="Quick search in audit logs"
                                   t-on-input="onSearchChange"/>
                        </div>
                        <div class="filter-group">
                            <label class="filter-label">Target User</label>
                            <select t-model="filters.user_id" class="filter-select" t-ref="userSelect"
                                    t-on-change="onUserFilterChange">
                                <option value="">All Users</option>
                                <t t-foreach="this.data?.users || []" t-as="user" t-key="user.id">
                                    <option
                                            t-att-value="user.id"
                                            t-att-selected="filters.user_id == user.id">
                                        <t t-esc="user.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="filter-group">
                            <label class="filter-label">Action Type</label>
                            <select class="filter-select" t-on-change="onActionFilterChange">
                                <option value="">All Actions</option>
                                <t t-foreach="this.data?.actions_list || []" t-as="action" t-key="action">
                                    <option t-att-value="action">
                                        <t t-esc="action"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="filter-group">
                            <label class="filter-label">Performed By</label>
                            <select class="filter-select" t-on-change="onAdminFilterChange">
                                <option value="">All Admins</option>
                                <t t-foreach="this.data?.admins || []" t-as="admin" t-key="admin.id">
                                    <option t-att-value="admin.id">
                                        <t t-esc="admin.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="filter-group">
                            <label class="filter-label">Date From</label>
                            <input type="date"
                                   class="filter-input"
                                   t-model="from_date.value"
                                   t-on-change="onDateChange"/>
                        </div>
                        <div class="filter-group">
                            <label class="filter-label">Date To</label>
                            <input type="date"
                                   class="filter-input"
                                   t-model="to_date.value"
                                   t-on-change="onDateChange"/>
                        </div>
                    </div>
                    <table class="audit-table">
                        <thead>
                            <tr>
                                <th>Timestamp</th>
                                <th>Performed By</th>
                                <th>Target User</th>
                                <th>Action</th>
                                <th>Details</th>
                                <th>IP Address</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="this.data.logs.length > 0">
                                <tr t-foreach="this.data?.logs" t-as="log" t-key="log_index + '_logs_available' ">
                                    <td>
                                        <div class="timestamp">
                                            <t t-esc="log.create_date[0]"/>
                                        </div>
                                        <div class="timestamp">
                                            <t t-esc="log.create_date[1]"/>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="actor">
                                            <div class="avatar-small">
                                                <t t-esc="this.getInitials(log.create_uid[0])"/>
                                            </div>
                                            <div>
                                                <div class="user-name">
                                                    <t t-esc="log.create_uid[0]"/>
                                                </div>
                                                <div class="user-email">
                                                    <t t-esc="log.create_uid[1]"/>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="target">
                                            <div class="avatar-small">
                                                <t t-esc="this.getInitials(log.user_uid[0])"/>
                                            </div>
                                            <div>
                                                <div class="user-name">
                                                    <t t-esc="log.user_uid[0]"/>
                                                </div>
                                                <div class="user-email">
                                                    <t t-esc="log.user_uid[1]"/>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="action-badge" t-esc="log.action"/>
                                    </td>
                                    <td>
                                        <div>
                                            <t t-esc="log.method"/>
                                        </div>
                                        <div class="action-detail">Reason: ???</div>
                                    </td>
                                    <td class="timestamp">
                                        <t t-esc="log.ip_address"/>
                                    </td>
                                    <td>
                                        <a class="details-link" t-att-data-json="log.data_json"
                                           t-on-click="open_details">
                                            View Details
                                        </a>
                                    </td>
                                </tr>
                            </t>
                            <t t-else="">
                                <tr>
                                    <td colspan="7" style="text-align:center; padding: 20px; color: #999;">
                                        No record found.
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <t t-if="this.data.logs.length > 0">
                        <div class="pagination">
                            <button t-att-class="'page-btn ' + (this.currentPage.value === 1 ? 'disabled' : '')"
                                    t-on-click="() => this.goToPage(this.currentPage.value - 1)">← Previous
                            </button>

                            <t t-foreach="Array.from({length: this.totalPages.value}, (_, i) => i + 1)" t-as="page"
                               t-key="page">
                                <button t-att-class="'page-btn ' + (page === this.currentPage.value ? 'active' : '')"
                                        t-on-click="() => this.goToPage(page)">
                                    <t t-esc="page"/>
                                </button>
                            </t>

                            <button t-att-class="'page-btn ' + (this.currentPage.value === this.totalPages.value ? 'disabled' : '')"
                                    t-on-click="() => this.goToPage(this.currentPage.value + 1)">Next →
                            </button>
                        </div>
                    </t>
                </div>
            </div>
            <!-- Detail Modal -->
            <div id="detailModal" class="modal-overlay" t-on-click="closeModalOnOverlay">
                <div class="audit_modal">
                    <div class="modal-header">
                        <h3 class="modal-title">Audit Log Details</h3>
                        <button class="close-btn" t-on-click="closeModal">×</button>
                    </div>
                    <div class="modal-body" id="modalContent">
                        <!-- Content will be inserted here by JavaScript -->
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
