<odoo>
    <data>
        <record id="view_res_users_list_user_permission" model="ir.ui.view">
            <field name="name">User Permissions Form</field>
            <field name="model">res.users</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="name"/>
                    <button name="client_action_view_user_permission" type="object" class="p-0" icon="fa-bar-chart pe-1"
                            string="Form view"/>
                </list>
            </field>
        </record>
        <record id="act_window_res_users_list_user_permission" model="ir.actions.act_window">
            <field name="name">User Permissions</field>
            <field name="res_model">res.users</field>
            <field name="path">user_permission</field>
            <field name="view_mode">list</field>
            <field name="context">{'default_active': False, 'default_name': 'New User Role'}</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_res_users_list_user_permission')})]"/>
        </record>
    </data>
</odoo>