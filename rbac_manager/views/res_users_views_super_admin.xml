<odoo>
    <data>
        <record id="view_res_users_client_super_admin" model="ir.actions.client">
            <field name="name">Super Admin</field>
            <field name="tag">rbac.super_admin</field>
            <field name="path">view_super_admin</field>
        </record>

        <record id="view_res_users_list_super_admin" model="ir.ui.view">
            <field name="name">Super Admin Form</field>
            <field name="model">res.users</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="name"/>
                    <button name="client_action_view_super_admin" type="object" class="p-0" icon="fa-bar-chart pe-1"
                            string="Form view"/>
                </list>
            </field>
        </record>
        <record id="act_window_res_users_list_super_admin" model="ir.actions.act_window">
            <field name="name">Super Admin</field>
            <field name="res_model">res.users</field>
            <field name="path">super_admin</field>
            <field name="view_mode">list</field>
            <field name="domain">[('is_user_role', '=', False)]</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_res_users_list_super_admin')})]"/>
        </record>
    </data>
</odoo>