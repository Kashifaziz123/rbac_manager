<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="request_rbac_permission_form" model="ir.ui.view">
            <field name="name">request.rbac.permission.form</field>
            <field name="model">request.rbac.permission</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar"/>
                        <button string="Approve" invisible="state != 'pending'" class="btn-secondary" type="object"
                                name="state_approved"/>
                        <button string="Deny" invisible="state != 'pending'" class="btn-secondary" type="object"
                                name="state_denied"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="group_id" readonly="state != 'pending'"/>
                            <field name="inverse_implied_ids" widget="many2many_tags" readonly="1"
                                   invisible="type != 'deny'"/>
                            <field name="description" readonly="state != 'pending'"/>
                        </group>
                        <group>
                            <group>
                                <field name="user_id" readonly="state != 'pending'"/>
                                <field name="type" readonly="state != 'pending'"/>
                            </group>
                            <group>
                                <field name="requested_by" readonly="state != 'pending'"/>
                                <field name="approved_by" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="request_rbac_permission_list" model="ir.ui.view">
            <field name="name">request.rbac.permission.list</field>
            <field name="model">request.rbac.permission</field>
            <field name="arch" type="xml">
                <list>
                    <field name="user_id"/>
                    <field name="requested_by"/>
                    <field name="type"/>
                    <field name="state"/>
                </list>
            </field>
        </record>
        <record id="request_rbac_permission_act_window" model="ir.actions.act_window">
            <field name="name">Permission Requests</field>
            <field name="res_model">request.rbac.permission</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="request_rbac_permission_dashboard_action" model="ir.actions.client">
            <field name="name">Requests</field>
            <field name="tag">rbac.requests_dashboard</field>
        </record>
    </data>
</odoo>
