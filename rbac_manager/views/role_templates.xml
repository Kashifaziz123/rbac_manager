<odoo>
    <data>
        <record id="client_action_role_templates" model="ir.actions.client">
            <field name="name">Role Templates</field>
            <field name="tag">rbac.role_templates</field>
            <field name="path">role_templates_form</field>
        </record>

        <record id="view_res_users_list_role_templates" model="ir.ui.view">
            <field name="name">Role Templates Form</field>
            <field name="model">res.users</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="name"/>
                    <button name="client_action_view_role_template" type="object" class="p-0" icon="fa-bar-chart pe-1"
                            string="Form view"/>
                </list>
            </field>
        </record>
        <record id="act_window_res_users_list_role_templates" model="ir.actions.act_window">
            <field name="name">Role Templates</field>
            <field name="res_model">res.users</field>
            <field name="path">role_templates</field>
            <field name="view_mode">list</field>
            <field name="domain">[('active', '=', False), ('name', 'ilike', 'template')]</field>
            <field name="context">{'default_active': False, 'default_name': 'New Template'}</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_res_users_list_role_templates')})]"/>
        </record>
    </data>
</odoo>