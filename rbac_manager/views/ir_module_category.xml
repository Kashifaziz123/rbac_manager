<odoo>
    <record id="view_module_category_tree" model="ir.ui.view">
        <field name="name">ir.module.category</field>
        <field name="model">ir.module.category</field>
        <field name="arch" type="xml">
            <list string="Module Categories">
                <field name="name"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>
    <record id="action_module_category" model="ir.actions.act_window">
        <field name="name">Module Categories</field>
        <field name="res_model">ir.module.category</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids"
               eval="[(5, 0, 0),
                   (0, 0, {'view_mode': 'list', 'view_id': ref('rbac_manager.view_module_category_tree')}),
                   (0, 0, {'view_mode': 'form', 'view_id': ref('base.view_module_category_form')})]"/>
    </record>
    <record id="view_module_category_form_inherit" model="ir.ui.view">
        <field name="name">ir.module.category.form.inherit</field>
        <field name="model">ir.module.category</field>
        <field name="inherit_id" ref="base.view_module_category_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description']" position="after">
                <label for="is_permission_menu" string="is permission"/>
                <field name="is_permission_menu" widget="boolean" no_label="1"/>
                <field name="child_group_ids" invisible="is_permission_menu == False">
                    <list editable="bottom" delete="0">
                        <field name="name"/>
                        <field name="is_child_permission"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
